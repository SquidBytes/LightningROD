#!/usr/bin/env bash
#
# LightningROD pre-commit hook.
#
# Content checks (PII + reference hygiene) run via scripts/checker.py.
# Lint (ruff) and types (mypy, advisory) run after.
#
# Activate once per clone:
#     git config core.hooksPath .githooks
#
# Bypass (use sparingly):
#     git commit --no-verify
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Pick the interpreter — prefer the repo venv so behavior matches CI.
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "pre-commit: python3 not found; cannot run content checks." >&2
    exit 1
fi

# --- Content checks: PII scan + reference hygiene ---
"$PYTHON" scripts/checker.py

# --- ruff lint on staged Python ---
mapfile -t staged_py < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ "${#staged_py[@]}" -eq 0 ]; then
    exit 0
fi

if [ -x "$REPO_ROOT/.venv/bin/ruff" ]; then
    RUFF="$REPO_ROOT/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
else
    echo "pre-commit: ruff not found; skipping lint (CI will still check)."
    exit 0
fi

echo "pre-commit: ruff on ${#staged_py[@]} staged Python file(s)..."
if ! "$RUFF" check "${staged_py[@]}"; then
    echo
    echo "pre-commit: ruff issues. Fix with: $RUFF check --fix ${staged_py[*]}"
    exit 1
fi

# --- mypy (advisory; does not block) ---
if [ -x "$REPO_ROOT/.venv/bin/mypy" ]; then
    MYPY="$REPO_ROOT/.venv/bin/mypy"
elif command -v mypy >/dev/null 2>&1; then
    MYPY="mypy"
else
    MYPY=""
fi
if [ -n "$MYPY" ]; then
    echo "pre-commit: mypy (advisory)..."
    "$MYPY" web/ config.py db/ --no-error-summary 2>&1 || \
        echo "pre-commit: mypy reported issues (not blocking; CI will enforce)."
fi

exit 0
