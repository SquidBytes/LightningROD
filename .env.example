# Database — single URL controls everything.
# Default (compose with PG sidecar):
DATABASE_URL=postgresql+asyncpg://lightningrod:changeme@localhost/lightningrod
# Standalone (SQLite, single container):
# DATABASE_URL=sqlite+aiosqlite:////data/lightningrod.db

# Application
APP_PORT=8000
DEBUG=false

# Read-only mode — when 'true', blocks DELETE/PUT/PATCH and renders a banner.
DEMO_MODE=false

# Docker image versioning — used as the tag for lightningrod-web:<tag> and
# baked into the image as LABEL + ENV. Leave unset or "dev" for local work;
# scripts/bump-version.sh keeps this in sync with pyproject.toml / package.json.
LIGHTNINGROD_VERSION=dev
